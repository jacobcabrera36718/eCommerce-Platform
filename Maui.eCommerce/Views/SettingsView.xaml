<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.SettingsView"
             Title="Settings">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Set Tax Rate (%)" FontSize="18" />
        <Entry Text="{Binding TaxRate}" Keyboard="Numeric" />
        <Label Text="Changes are saved automatically." FontAttributes="Italic" FontSize="12" />
        <Button Text="Return to Home"
        Clicked="Return_Clicked"
        HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
